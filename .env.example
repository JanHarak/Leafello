# Zkopíruj tento soubor na `.env` (ten je v .gitignore a NIKDY se necommituje)
# a doplň hodnoty ze Supabase dashboardu svého projektu.
# Tajné klíče NEPOSÍLEJ do chatu – stačí je mít tady v .env, přečtu si je lokálně.

# ─────────────────────────────────────────────────────────────
# KLIENT – veřejné hodnoty, smí být v EXPO_PUBLIC_* i v klientovi
# Supabase → Project Settings → Data API  (URL)  a  → API Keys  (anon public)
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://TVUJ-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# SERVER / ADMIN – TAJNÉ. Nikdy v klientovi, nikdy v EXPO_PUBLIC_*, nikdy v gitu.
# ─────────────────────────────────────────────────────────────

# Přímé připojení k Postgresu pro spouštění migrací (zakládání tabulek).
# Supabase → Connect (tlačítko nahoře) → ORM/psql → zkopíruj "Session pooler" URI.
# Vypadá zhruba takto (port 5432, uživatel obsahuje project ref):
#   postgresql://postgres.TVUJ-REF:HESLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Volitelně: heslo k DB zvlášť (bez kódování). Když je vyplněné, použije se
# místo hesla v SUPABASE_DB_URL – užitečné, aby se URI nemuselo ručně kódovat.
# Vlož sem PŘESNĚ heslo databáze (Supabase → Project Settings → Database →
# Reset database password, hodnota se ukáže jen jednou).
SUPABASE_DB_PASSWORD=

# Service role klíč (Supabase → Project Settings → API Keys → service_role).
# Použije se jen na serveru / v Edge Functions, ne pro zakládání tabulek.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# GEMINI – tajné. Pro fotoanalýzu je klíč v Supabase secrets; lokálně se hodí
# jen pro `npm run import:usda` (dávkový překlad názvů do češtiny).
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
