{
  "name": "dietapp",
  "version": "0.1.0",
  "private": true,
  "description": "Hybridní aplikace pro deník jídel a hubnutí (Expo + Supabase + Gemini). Monorepo.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm --prefix app run start",
    "web": "npm --prefix app run web",
    "android": "npm --prefix app run android",
    "ios": "npm --prefix app run ios",
    "test": "npm run test --workspaces --if-present",
    "build:packages": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:styles": "node scripts/lint-styles.mjs",
    "db:push": "node scripts/db-push.mjs",
    "import:off": "node scripts/import-off.mjs",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "test:snapshot": "node supabase/tests/snapshot.test.mjs",
    "test:db": "npm run test:rls && npm run test:snapshot"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "supabase": "^2.116.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
