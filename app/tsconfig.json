{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@dietapp/nutrition-calc": [
        "../packages/nutrition-calc/src"
      ],
      "@dietapp/gamification-rules": [
        "../packages/gamification-rules/src"
      ],
      "@dietapp/diary": [
        "../packages/diary/src"
      ],
      "@dietapp/nutrition-analyst": [
        "../packages/nutrition-analyst/src"
      ],
      "@dietapp/reminders": [
        "../packages/reminders/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
